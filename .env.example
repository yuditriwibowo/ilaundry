# Copy from .env.local on the Vercel dashboard
# https://nextjs.org/learn/dashboard-app/setting-up-your-database#create-a-postgres-database
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# NextAuth (Auth.js v5)
# Generate: openssl rand -base64 32
# JANGAN set AUTH_URL di Vercel — Auth.js v5 mendeteksi URL dari request.
AUTH_SECRET=
AUTH_TRUST_HOST=true

# MFA email (Resend)
# TESTING: semua email kode MFA terkirim ke MFA_EMAIL_TO (alamat ini harus
# terdaftar di akun Resend karena domain belum diverifikasi). PRODUKSI:
# kosongkan MFA_EMAIL_TO agar terkirim ke email pendaftar, dan set
# RESEND_FROM_EMAIL ke alamat domain terverifikasi (resend.com/domains).
MFA_EMAIL_TO=
# RESEND_FROM_EMAIL="yLaundry <noreply@domain-anda.com>"
